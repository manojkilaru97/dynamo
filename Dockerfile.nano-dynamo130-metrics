ARG BASE_IMAGE=nvcr.io/qc69jvmznzxy/llm_nim/nano@sha256:aaf5d3521bc6c9635e6ff5dba893c4d50c40d4e52d4fb55a652e8105a1762c0b
FROM ${BASE_IMAGE}

COPY --from=wheelhouse ai_dynamo_runtime-1.3.0-cp310-abi3-*.whl /tmp/dynamo-wheels/
COPY --from=sourcewheel ai_dynamo-1.3.0-py3-none-any.whl /tmp/dynamo-wheels/

RUN python3 -m pip install --no-deps --force-reinstall /tmp/dynamo-wheels/*.whl \
 && rm -rf /tmp/dynamo-wheels \
 && python3 -m compileall -q /usr/local/lib/python3.12/dist-packages/dynamo \
 && python3 - <<'PY'
from importlib.metadata import version
from pathlib import Path

import vllm

assert version("ai-dynamo") == "1.3.0"
assert version("ai-dynamo-runtime") == "1.3.0"
assert vllm.__version__ == "0.26.0"
core = Path("/usr/local/lib/python3.12/dist-packages/dynamo/_core.abi3.so")
assert b"dynamo_capture_records_written" in core.read_bytes()
PY

LABEL org.opencontainers.image.revision="77d32e6a0f85e499b9df2b3ff703b78fb10a7d6a" \
      ai.dynamo.version="1.3.0" \
      ai.dynamo.vllm.version="0.26.0" \
      ai.dynamo.base.digest="sha256:aaf5d3521bc6c9635e6ff5dba893c4d50c40d4e52d4fb55a652e8105a1762c0b" \
      ai.dynamo.capture-metrics="prometheus-v1"
