COPY --from=wheelhouse ai_dynamo_runtime-1.3.0-cp310-abi3-linux_x86_64.whl /tmp/dynamo-wheels/
COPY --from=sourcewheel ai_dynamo-1.3.0-py3-none-any.whl /tmp/dynamo-wheels/

RUN python3 -m pip uninstall -y ai-dynamo ai-dynamo-runtime \
 && rm -rf \
      /usr/local/lib/python3.12/dist-packages/dynamo \
      /usr/local/lib/python3.12/dist-packages/ai_dynamo-*.dist-info \
 && python3 -m pip install --no-deps /tmp/dynamo-wheels/*.whl \
 && rm -rf /tmp/dynamo-wheels

RUN python3 -m compileall -q /usr/local/lib/python3.12/dist-packages/dynamo \
 && python3 - <<'PY'
import hashlib
import importlib.metadata as metadata
from pathlib import Path

assert metadata.version("ai-dynamo") == "1.3.0"
assert metadata.version("ai-dynamo-runtime") == "1.3.0"
handlers = Path("/usr/local/lib/python3.12/dist-packages/dynamo/vllm/handlers.py")
assert hashlib.sha256(handlers.read_bytes()).hexdigest() == "938e2e517271afddaf1db9c67e629f17797b2ba3d16330c5ef307c47bc6f0d18"
processor = Path("/usr/local/lib/python3.12/dist-packages/dynamo/frontend/vllm_processor.py")
assert hashlib.sha256(processor.read_bytes()).hexdigest() == "edaa07d202d9b3b469eadbbf1d2ba58eb9725151904bf60bfaebb1a03995e5ef"
prepost = Path("/usr/local/lib/python3.12/dist-packages/dynamo/frontend/prepost.py")
assert hashlib.sha256(prepost.read_bytes()).hexdigest() == "088dbe8d5fb590cba45d48d8dd26f56f765e77cc77e780802f29f8fe709001c2"
PY

